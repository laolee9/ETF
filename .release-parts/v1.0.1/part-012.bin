␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀[project]
name = "dashboard-feature-usage"
version = "1.0.0"
description = "A feature usage analytics dashboard with filtering and starter kits"
requires-python = ">=3.10"
dependencies = [
    "altair>=5.5.0",
    "numpy>=1.26.0",
    "pandas>=2.2.3",
