    @overload  # ()
    def view(self, /) -> Self: ...
    @overload  # (dtype: T)
    def view[DTypeT: _dtype](self, /, dtype: DTypeT | _HasDType[DTypeT]) -> ndarray[_ShapeT_co, DTypeT]: ...
