@pytest.mark.slow
class TestValueAttr(util.F2PyTest):
    sources = [util.getpath("tests", "src", "value_attrspec", "gh21665.f90")]

    # gh-21665
    def test_gh21665(self):
        inp = 2
        out = self.module.fortfuncs.square(inp)
