        self._set_property("xaxes", arg, xaxes)
        self._set_property("xhoverformat", arg, xhoverformat)
        self._set_property("yaxes", arg, yaxes)
        self._set_property("yhoverformat", arg, yhoverformat)

        self._props["type"] = "splom"
        arg.pop("type", None)
