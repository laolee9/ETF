    x: _ArrayLikeComplex_co,
    y: _ArrayLikeComplex_co,
    deg: int,
    rcond: bool | None = None,
    full: L[False] = False,
    w: _ArrayLikeFloat_co | None = None,
    cov: L[False] = False
) -> NDArray[Incomplete]: ...
