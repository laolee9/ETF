        Returns
        -------
        int|float
        """
        return self["arrowwidth"]

    @arrowwidth.setter
    def arrowwidth(self, val):
        self["arrowwidth"] = val

    @property
    def ax(self):
        """
        Sets the x component of the arrow tail about the arrow head (in
