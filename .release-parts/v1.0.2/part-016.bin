        The 'ax' property is a number and may be specified as:
          - An int or float

        Returns
        -------
        int|float
        """
        return self["ax"]

    @ax.setter
    def ax(self, val):
        self["ax"] = val

    @property
    def ay(self):
        """
        Sets the y component of the arrow tail about the arrow head (in
