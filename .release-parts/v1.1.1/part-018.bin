    fill_value: int,
    usemask: Literal[False],
    asrecarray: Literal[False] = False,
) -> np.ndarray[ShapeT, np.dtype[np.void]]: ...
@overload
def append_fields[ShapeT: _Shape](
    base: np.ndarray[ShapeT, np.dtype[np.void]],
